[Unit]
Description=Video Pilot Raspberry Pi host
After=NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=video-pilot
Group=video-pilot
EnvironmentFile=/etc/video-pilot.env
WorkingDirectory=/opt/video-pilot/pi-host
ExecStart=/usr/bin/node /opt/video-pilot/pi-host/src/main.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/video-pilot

[Install]
WantedBy=multi-user.target
