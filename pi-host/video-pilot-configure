#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then echo "Run with sudo: sudo video-pilot-configure" >&2; exit 1; fi
printf "Video Pilot tunnel key (same key configured in Cloudflare): "
stty -echo
IFS= read -r secret
stty echo
printf "\n"
if [ -z "$secret" ]; then echo "A tunnel key is required." >&2; exit 1; fi
umask 077
cat > /etc/video-pilot.env <<EOF
VIDEO_PILOT_URL=https://tv.jch76.workers.dev
VIDEO_PILOT_SECRET=$secret
VIDEO_PILOT_DATA=/var/lib/video-pilot
YT_DLP=/opt/video-pilot/pi-host/.venv/bin/yt-dlp
EOF
systemctl restart video-pilot
systemctl --no-pager --full status video-pilot || true
